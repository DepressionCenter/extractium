# Fetched pages. Only saves time on the next run; deleting it is safe.
.kb_cache/

# A local build environment, when you build on your own machine.
.venv/

# The build output. The workflow publishes it straight to Pages, so it
# does not need to be committed. Remove this line if you build locally and
# want the files in the repository.
dist/

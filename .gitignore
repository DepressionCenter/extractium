# .gitignore - special file for Git telling it which files to ignore when committing changes to the repository

# Ignore all data files except the one that's tracked
# Example: .csv
# Example: !sample-data.csv

# Ignore RStudio project files/folders
.Rproj.user/
*.Rproj

# Ignore R cache and history
.RData
.RHistory
.Rhistory
.Ruserdata
.Rapp.history

# Ignore OS cruft
.DS_Store
Thumbs.db

# Ignore Logs
*.log
log.txt
logs.txt
logs/*

# Ignore Editor cruft
.vscode/
.idea/
*.swp

# Ignore AI coding tool configuration files, except AGENTS.md
.claude
.claude/*
.claudecode/*
.gemini
.gemini/*
.github/copilot-instructions.md
.github-copilot
.github-copilot/*
.kimi
CLAUDE.md
CLAUDECODE.md
CONVENTIONS.md
GEMINI.md
KIMI.md
CODEX.md
CHATGPT.md

# Ignore cache files
*.cache
__pycache__/
.venv/
# What a portable install builds beside the installer, named piece by
# piece rather than as the whole folder, because git on Windows matches
# names without regard to case and "Extractium/" would hide the package
/Extractium/uv
/Extractium/uv.exe
/Extractium/python/
/Extractium/venv/
/Extractium/bin/
/Extractium/cache/
/Extractium/installed-version.txt
/Extractium/not-portable.txt
/Extractium/last-folder.txt
/Extractium/install.bat
/Extractium/install.sh
# The zip the release workflow packs that folder into
*-portable*.zip
*-portable*.zip.sha256

# Ignore Extractium build/test artifacts
.kb_cache/
runs/
dist/
# The previous settings file the local page keeps beside a saved one
config.yaml.*.bak
build/
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Ignore packages an example installs for itself
node_modules/

# Ignore the reports a build writes where it runs
phi-lint-report.json
phi-lint-report.txt
